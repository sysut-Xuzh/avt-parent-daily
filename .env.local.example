# ===== Supabase 数据库（必填）=====
# 在 supabase.com 创建项目后，Project Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL=https://你的项目.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的anon-public-key

# ===== Web Push 推送（可选，用到推送功能才需要）=====
# 生成方式：npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== LLM 任务生成（可选，用到 AI 拆任务才需要）=====
# 支持 OpenAI / DeepSeek
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ===== Supabase Service Role Key（仅服务端 / .env.local，绝不进前端/ git）=====
# 用途：受控运维通道 / 服务端需要越权读取时的"全能钥匙"
# 获取：Supabase 控制台 Project Settings → API → service_role（secret）key
# 警告：此 key 绕过 RLS，等同于数据库管理员，必须严格保密
SUPABASE_SERVICE_ROLE_KEY=

# ===== 运维通道开关与白名单（阶段二·钥匙2）=====
# 总开关：设为 true 才启用 /api/admin/maintenance
ADMIN_MAINTENANCE_ENABLED=false
# 允许调用运维端点的管理员邮箱（逗号分隔）
ADMIN_ALLOWED_EMAILS=admin@example.com
